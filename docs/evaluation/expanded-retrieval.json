  "materials": [
    {
      "name": "原创评测·高等数学",
      "type": "TXT",
      "size": "",
      "status": "可检索",
      "passages": [
        {
          "section": "导数",
          "text": "导数描述函数在某点的瞬时变化率。若位置函数为 s(t)，其导数为瞬时速度。导数与某段区间上的累积量不同。"
        },
        {
          "section": "定积分",
          "text": "定积分表示区间上的有向累积量。速度对时间的定积分给出位移；速度可为负，因此位移不一定等于路程。"
        },
        {
          "section": "矩阵乘法",
          "text": "矩阵乘法有顺序。对列向量，ABx 表示先施加 B 再施加 A，AB 通常不等于 BA。"
        },
        {
          "section": "条件概率",
          "text": "条件概率 P(A|B)=P(A交B)/P(B)，要求 P(B)>0。事件独立时 P(A|B)=P(A)。"
        }
      ]
    },
    {
      "name": "原创评测·大学物理",
      "type": "TXT",
      "size": "",
      "status": "可检索",
      "passages": [
        {
          "section": "匀速运动",
          "text": "匀速直线运动的位移等于速度乘时间，计算前统一单位。速度为每秒 2 米，持续 3 分钟，位移为 360 米。"
        },
        {
          "section": "加速度",
          "text": "加速度是速度对时间的变化率，单位为米每二次方秒。加速度为零表示速度不变，不代表速度为零。"
        },
        {
          "section": "牛顿第二定律",
          "text": "在惯性参考系中，质量不变的物体满足合力等于质量乘加速度 F=ma。这里的力是合外力，不是任意一个力。"
        },
        {
          "section": "动量",
          "text": "动量 p=mv，是具有方向的矢量。系统合外力为零时总动量守恒；动能守恒需要另外的条件。"
        }
      ]
    },
    {
      "name": "原创评测·程序设计",
      "type": "TXT",
      "size": "",
      "status": "可检索",
      "passages": [
        {
          "section": "二分查找",
          "text": "二分查找要求待查序列有序，每次比较中间位置，排除一半候选区间。时间复杂度 O(log n)。"
        },
        {
          "section": "栈",
          "text": "栈遵循后进先出，最后入栈的元素最先出栈。函数调用与撤销操作常使用栈。"
        },
        {
          "section": "队列",
          "text": "队列遵循先进先出，先入队的元素先出队。任务排队可以用队列实现，区别于后进先出的栈。"
        },
        {
          "section": "事务",
          "text": "数据库事务的一致性和原子性保证一组更新全部成功或全部回滚。并发版本检查可以拒绝过期写入，避免覆盖新修改。"
        }
      ]
    }
  ],
