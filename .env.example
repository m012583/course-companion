# Copy to .env.local. Never commit real credentials.
# Full configuration: docs/ENVIRONMENT.md
# Optional AI configuration. The knowledge base, manual notes, review, and
# saved-link knowledge graph work without these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# For another compatible provider, explicitly enable vision only if supported:
# OPENAI_SUPPORTS_VISION=true

# start:local creates COURSE_KB_AI_SECRET in .env.local for encrypted UI settings.
# Do not publish that secret or copy it into shared examples.
